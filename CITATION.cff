    given-names: Christian
version: "3.2.0"
date-released: "2026-10-21"
license: MIT
repository-code: "https://github.com/Ce1ectric/groundfault"
url: "https://ce1ectric.github.io/groundfault/"
keywords:
  - earth fault
  - resonant earthing
  - Petersen coil
  - compensated network
  - medium voltage
  - COMTRADE
  - residual earth-fault current
  - harmonics
  - earthing system
